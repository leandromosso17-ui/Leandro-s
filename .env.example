# ElevenLabs — powers the reminder phone-call voice.
# Get a key at https://elevenlabs.io (Profile → API Keys).
# Copy this file to .env.local and fill in your key.
ELEVENLABS_API_KEY=

# Optional overrides:
# Voice id (default "George", a warm male voice). Browse voices in the ElevenLabs app.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Model id (turbo is fast + cheap and great for demos).
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ─── Build-time (client) — must be present when `expo export` runs ──────────
# Point medimo's SMS + voice providers at the bundled serverless functions.
# Setting these switches the app from mock providers to the real backend.
EXPO_PUBLIC_SMS_ENDPOINT=/api/sms
EXPO_PUBLIC_VOICE_ENDPOINT=/api/call
# Optional ElevenLabs agent id (not required — /api uses text-to-speech):
# EXPO_PUBLIC_ELEVENLABS_AGENT_ID=

# ─── Runtime (server) — read by /api functions, never shipped to the browser ─
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Only set if Twilio can't reach /api/twiml automatically (auto-detected on Vercel):
# PUBLIC_BASE_URL=https://your-app.vercel.app

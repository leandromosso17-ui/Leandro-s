# ─── ElevenLabs (reminder call voice) ───────────────────────────────
# Get a key at https://elevenlabs.io (Profile → API Keys).
ELEVENLABS_API_KEY=
# Optional overrides:
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George" — warm male voice
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ─── Twilio (real SMS + phone calls) ────────────────────────────────
# Free trial works: https://www.twilio.com/try-twilio
#  - Trial gives free credit + a phone number.
#  - You can only text/call numbers you've VERIFIED in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX             # your Twilio number, E.164

# Public base URL Twilio uses to fetch the call audio (/api/twiml, /api/voice).
# On Vercel this is auto-detected from the request; set it only if that fails
# or when tunneling localhost (e.g. an ngrok https URL).
# PUBLIC_BASE_URL=https://your-app.vercel.app
